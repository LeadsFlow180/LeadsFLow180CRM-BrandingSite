# Public site URL (used for Stripe + email verify redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Checkout — only the secret key is required.
STRIPE_SECRET_KEY=sk_test_...

# Optional: pin a Dashboard Price instead of auto-create
# STRIPE_PRICE_ID=price_...

# Optional zero-code fallback:
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# Agent talk (email verify + timed chat)
# AGENT_TALK_SECRET=long-random-string
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=LeadsFlow180 <hello@yourdomain.com>
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LEADS_WEBHOOK_URL=https://hooks.example.com/leads
