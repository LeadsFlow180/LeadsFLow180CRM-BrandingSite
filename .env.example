# Public site URL (used for Stripe success / cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Checkout — only the secret key is required.
# On first Subscribe, the API creates the Launch Founders Product + $697/mo Price if missing.
STRIPE_SECRET_KEY=sk_test_...

# Optional: pin a Dashboard Price instead of auto-create
# STRIPE_PRICE_ID=price_...

# Optional zero-code fallback (skips session + catalog create):
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
